# Application
# APP_ENV: development | test | production
# Required for local startup: DATABASE_URL, BETTER_AUTH_URL/NEXT_PUBLIC_APP_URL, BETTER_AUTH_SECRET, API_INTERNAL_URL
# Production additionally requires AUTH_EMAIL_MODE=smtp plus SMTP_HOST/SMTP_PORT/SMTP_FROM
# Optional until used: REDIS_URL and S3_*
APP_ENV=development
APP_PORT=8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret with at least 32 characters.
# Production rejects the placeholder value below.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
API_INTERNAL_URL=http://localhost:8080

# Database
DATABASE_URL=postgres://saas:saas@localhost:5432/saas?sslmode=disable

# Local auth email capture (Mailpit). Production must use AUTH_EMAIL_MODE=smtp with working SMTP.
AUTH_EMAIL_MODE=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="SaaS Foundry <no-reply@localhost>"
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional infrastructure
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
